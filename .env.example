# Base URL of the Alloy Navigator server this connector talks to. Alloy
# Navigator has no single hosted endpoint - every instance is on-prem or a
# customer's own self-hosted-cloud tenant.
ALLOY_BASE_URL=

# Application account credentials (Settings App > Services > API >
# Applications), used for the OAuth2 client_credentials grant against
# <ALLOY_BASE_URL>/api/token. Application accounts run without a signed-in
# user present - the right shape for an unattended MCP connector.
ALLOY_CLIENT_ID=
ALLOY_CLIENT_SECRET=
